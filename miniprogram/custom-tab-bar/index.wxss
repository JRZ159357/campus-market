/* 文件路径: miniprogram/custom-tab-bar/index.wxss */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tabbar__icon {
  font-size: 38rpx;
  line-height: 1;
  filter: grayscale(100%);
  opacity: 0.55;
}

.tabbar__icon--active {
  filter: none;
  opacity: 1;
}

.tabbar__label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
}

.tabbar__label--active {
  color: #ff6b35;
  font-weight: 600;
}

/* 中间发布按钮：橙色圆形凸起 */
.tabbar__item--center {
  position: relative;
}

.tabbar__plus {
  position: absolute;
  top: -34rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff9a6b);
  color: #fff;
  font-size: 52rpx;
  line-height: 84rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.4);
}

.tabbar__publish {
  position: absolute;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #ff6b35;
  font-weight: 600;
}

/* 图标容器：为消息角标提供定位上下文 */
.tabbar__icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 未读角标：圆形红色数字，超过 99 显示 99+ */
.tabbar__badge {
  position: absolute;
  top: -8rpx;
  left: 22rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 14rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 19rpx;
  line-height: 28rpx;
  text-align: center;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(255, 59, 48, 0.4);
}
