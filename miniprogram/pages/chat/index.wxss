/* 文件路径: miniprogram/pages/chat/index.wxss */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* ---------------- 顶部 ---------------- */
.chat-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 30rpx;
  background: #fff;
  box-shadow: 0 1rpx 0 #eee;
}

.chat-head__main {
  display: flex;
  flex-direction: column;
}

.chat-head__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.chat-head__status {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot--on {
  background: #52c41a;
}

.dot--off {
  background: #ff4d4f;
}

.chat-head__status-text {
  font-size: 21rpx;
  color: #999;
}

.chat-head__more {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #666;
  font-size: 34rpx;
  line-height: 52rpx;
  text-align: center;
}

/* ---------------- 关联商品条 ---------------- */
.product-bar {
  flex: none;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: #fffaf7;
  border-bottom: 1rpx solid #ffeade;
}

.product-bar__img {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.product-bar__img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #ccc;
}

.product-bar__body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.product-bar__title {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bar__tip {
  font-size: 21rpx;
  color: #ff6b35;
  margin-top: 4rpx;
}

.product-bar__arrow {
  font-size: 34rpx;
  color: #ccc;
  margin-left: 12rpx;
}

/* ---------------- 消息区 ---------------- */
.chat-body {
  flex: 1;
  padding: 20rpx 24rpx 10rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.more-tip {
  padding: 16rpx 0;
  text-align: center;
  font-size: 21rpx;
  color: #bbb;
}

.msg-wrap {
  margin-bottom: 26rpx;
}

.msg-time {
  text-align: center;
  font-size: 21rpx;
  color: #b5b5b5;
  margin: 16rpx 0;
}

/* 系统消息：居中灰色小字 */
.sys-msg {
  display: flex;
  justify-content: center;
  margin: 14rpx 0;
}

.sys-msg text {
  max-width: 78%;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #999;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.msg-row {
  display: flex;
  align-items: flex-start;
}

.msg-row--self {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 50%;
  background: linear-gradient(135deg, #d9d9d9, #bfbfbf);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-avatar--self {
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
}

.msg-content {
  max-width: 72%;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}

.msg-row--self .msg-content {
  align-items: flex-end;
}

/* 气泡 */
.bubble {
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 自己的：橙色渐变 + 白字 */
.bubble--self {
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  color: #fff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.24);
}

/* 对方的：白色 + 淡阴影 */
.bubble--other {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 图片消息 */
.msg-image {
  width: 320rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

/* 商品 / 订单卡片 */
.card {
  display: flex;
  width: 440rpx;
  padding: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.card__img {
  width: 120rpx;
  height: 120rpx;
  flex: none;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.card__img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ddd;
}

.card__body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.card__title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card__no {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.card__price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 700;
  margin-top: 6rpx;
}

.card__tag {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #888;
  font-size: 20rpx;
}

/* 正在输入 */
.typing {
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  color: #999;
}

.bottom-anchor {
  height: 12rpx;
}

/* ---------------- 底部输入 ---------------- */
.chat-foot {
  flex: none;
  background: #fff;
  box-shadow: 0 -1rpx 0 #eee;
}

.emoji-panel {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx 6rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.emoji-panel__item {
  width: 12.5%;
  height: 72rpx;
  font-size: 40rpx;
  text-align: center;
  line-height: 72rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
}

.input-bar__icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  font-size: 36rpx;
  text-align: center;
  line-height: 64rpx;
}

.input-bar__input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  margin: 0 12rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 27rpx;
  color: #333;
}

.input-bar__ph {
  color: #bbb;
}

.input-bar__send {
  flex: none;
  width: 110rpx;
  height: 66rpx;
  border-radius: 33rpx;
  background: #e5e5e5;
  color: #fff;
  font-size: 27rpx;
  text-align: center;
  line-height: 66rpx;
}

.input-bar__send--on {
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
}

.quick-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 20rpx 16rpx;
}

.quick-bar__btn {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #fff4ee;
  color: #ff6b35;
  font-size: 22rpx;
}
