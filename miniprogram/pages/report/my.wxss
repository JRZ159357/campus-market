/* 文件路径: miniprogram/pages/report/my.wxss */
.page {
  min-height: 100vh;
  background: #f5f6f8;
}

.page__body {
  padding: 24rpx;
}

.list__footer {
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b1b3b8;
}

.loading {
  padding: 140rpx 0;
  text-align: center;
}

.loading__dot {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 16rpx;
  border: 4rpx solid #ff6b35;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading__text {
  font-size: 24rpx;
  color: #a8abb2;
}

/* ---------------- 举报卡片 ---------------- */
.item {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item__head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.item__type {
  font-size: 26rpx;
  font-weight: 600;
}

.item__status {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.item__target {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.item__cover {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 10rpx;
  background: #f5f7fa;
}

.item__cover--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #c0c4cc;
}

.item__targetBody {
  flex: 1;
  min-width: 0;
}

.item__title {
  font-size: 28rpx;
  color: #303133;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a8abb2;
}

.item__content {
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
  /* 限高3行，完整内容进详情看，避免卡片过长把列表撑散 */
  max-height: 130rpx;
  overflow: hidden;
}

/* 处理结果块：成立用绿底、驳回用灰底 */
.item__result {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
}

.item__result--2 {
  background: #f0f9eb;
}

.item__result--3 {
  background: #f4f4f5;
}

.item__resultTitle {
  font-size: 24rpx;
  font-weight: 600;
  color: #606266;
  margin-bottom: 6rpx;
}

.item__resultText {
  font-size: 24rpx;
  color: #606266;
  line-height: 1.6;
}

.item__pending {
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  background: #fdf6ec;
  font-size: 24rpx;
  color: #b88230;
}

/* ---------------- 空状态 ---------------- */
.empty {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty__icon {
  font-size: 96rpx;
}

.empty__text {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #606266;
}

.empty__hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a8abb2;
  line-height: 1.6;
}

/* ---------------- 详情弹层 ---------------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  animation: slide-up 0.24s ease;
}

@keyframes slide-up {
  from {
    transform: translateY(40rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet__bar {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 0;
  border-radius: 4rpx;
  background: #dcdfe6;
}

.sheet__head {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 2rpx solid #f2f3f5;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.sheet__close {
  margin-left: auto;
  font-size: 44rpx;
  line-height: 1;
  color: #c0c4cc;
}

.sheet__body {
  flex: 1;
  max-height: 66vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet__status {
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.sheet__target {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.sheet__cover {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border-radius: 10rpx;
  background: #fff;
}

.sheet__cover--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #c0c4cc;
}

.sheet__targetBody {
  flex: 1;
  min-width: 0;
}

.sheet__targetTitle {
  font-size: 28rpx;
  color: #303133;
}

.sheet__targetMeta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a8abb2;
}

.sheet__section {
  margin-top: 28rpx;
}

.sheet__label {
  font-size: 26rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 12rpx;
}

.sheet__content {
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  color: #606266;
  line-height: 1.7;
}

.sheet__images {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.sheet__img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #f5f7fa;
}

/* 时间线 */
.timeline {
  padding-left: 8rpx;
}

.timeline__row {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
}

.timeline__row::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #ebeef5;
}

.timeline__row:last-child::before {
  display: none;
}

.timeline__dot {
  position: relative;
  z-index: 1;
  width: 24rpx;
  height: 24rpx;
  flex: none;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #c0c4cc;
  box-shadow: 0 0 0 6rpx #fff;
}

.timeline__dot--primary {
  background: #409eff;
}

.timeline__dot--warning {
  background: #e6a23c;
}

.timeline__dot--danger {
  background: #f56c6c;
}

.timeline__dot--muted {
  background: #dcdfe6;
}

.timeline__dot--hollow {
  background: #fff;
  border: 3rpx solid #dcdfe6;
}

.timeline__title {
  font-size: 26rpx;
  color: #303133;
}

.timeline__title--muted {
  color: #b1b3b8;
}

.timeline__time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a8abb2;
}

.sheet__result {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 12rpx;
}

.sheet__resultLabel {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.sheet__resultText {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.7;
}

.sheet__action {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
  font-size: 22rpx;
  color: #909399;
}