/* 文件路径: miniprogram/pages/report/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 140rpx;
}

.page__body {
  padding: 24rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card__title {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.card__required {
  margin-left: 6rpx;
  color: #f56c6c;
}

.card__count {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: #b1b3b8;
}

.card__tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #a8abb2;
  line-height: 1.6;
}

/* ---------------- 被举报对象卡片 ---------------- */
.target-card {
  border-left: 8rpx solid #409eff;
}

.target-card__type {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.target-card__main {
  display: flex;
  gap: 20rpx;
}

.target-card__cover {
  width: 120rpx;
  height: 120rpx;
  flex: none;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.target-card__cover--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #c0c4cc;
}

.target-card__body {
  flex: 1;
  min-width: 0;
}

.target-card__title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  line-height: 1.5;
}

.target-card__extra {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #909399;
}

.target-card__tip {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-size: 22rpx;
  color: #909399;
  line-height: 1.6;
}

/* ---------------- 举报原因 ---------------- */
.reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.reason {
  flex: 1 1 calc(33.333% - 16rpx);
  min-width: 0;
  padding: 18rpx 12rpx;
  border: 2rpx solid #ebedf0;
  border-radius: 12rpx;
  background: #fafbfc;
  text-align: center;
  transition: all 0.15s;
}

.reason--active {
  border-color: #ff6b35;
  background: #fff3ec;
}

.reason__label {
  font-size: 26rpx;
  color: #303133;
}

.reason--active .reason__label {
  color: #ff6b35;
  font-weight: 600;
}

.reason__desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a8abb2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------- 描述与图片 ---------------- */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #ebedf0;
  border-radius: 12rpx;
  background: #fafbfc;
  font-size: 28rpx;
  line-height: 1.6;
  color: #303133;
  box-sizing: border-box;
}

.textarea__ph {
  color: #b1b3b8;
  font-size: 26rpx;
}

.field-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #f56c6c;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.images__item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.images__img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.images__remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
}

.images__add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #dcdfe6;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.images__plus {
  font-size: 48rpx;
  color: #c0c4cc;
  line-height: 1;
}

.images__addText {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a8abb2;
}

/* ---------------- 提示 ---------------- */
.notice {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fff9e6;
  font-size: 22rpx;
  color: #b88230;
  line-height: 1.7;
}

/* ---------------- 空状态 ---------------- */
.empty {
  padding: 140rpx 40rpx;
  text-align: center;
}

.empty__icon {
  font-size: 96rpx;
}

.empty__text {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #606266;
}

.empty__hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a8abb2;
}

/* ---------------- 骨架屏 ---------------- */
.skeleton {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e9ebee 37%, #f2f3f5 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

.skeleton--cover {
  width: 120rpx;
  height: 120rpx;
  flex: none;
}

.skeleton--line {
  height: 28rpx;
  margin-bottom: 14rpx;
}

.skeleton--short {
  width: 60%;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ---------------- 底部提交栏 ---------------- */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.footer__link {
  padding: 0 12rpx;
  font-size: 26rpx;
  color: #909399;
  white-space: nowrap;
}

.footer__submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.footer__submit::after {
  border: none;
}

.footer__submit[disabled] {
  background: #dcdfe6;
  color: #fff;
}