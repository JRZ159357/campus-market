/* 文件路径: miniprogram/pages/auth/student.wxss */

.status-card {
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.status-card--wait {
  background: linear-gradient(135deg, #ff9a5c, #ff6b35);
}

.status-card--pass {
  background: linear-gradient(135deg, #67c23a, #85ce61);
}

.status-card--reject {
  background: linear-gradient(135deg, #f56c6c, #f89898);
}

.status-card__title {
  font-size: 36rpx;
  font-weight: 600;
}

.status-card__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.95;
}

.status-card__meta {
  margin-top: 16rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.field__label {
  font-size: 27rpx;
  color: #333;
  margin-bottom: 14rpx;
}

.required {
  color: #f56c6c;
  margin-left: 6rpx;
}

.field__input {
  background: #f8f8f8;
  border-radius: 12rpx;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.ph {
  color: #c4c4c4;
}

.field__hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #aaa;
}

.uploader {
  position: relative;
  width: 260rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  border: 2rpx dashed #ffcfbd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.uploader__img {
  width: 100%;
  height: 100%;
}

.uploader__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.uploader__plus {
  font-size: 52rpx;
  color: #ffb59b;
  line-height: 1;
}

.uploader__text {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #ff9a6b;
}

.submit-btn {
  margin-top: 40rpx;
}

.tips {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.6;
}

.benefit {
  font-size: 27rpx;
  color: #555;
  line-height: 2;
}
