/* 文件路径: miniprogram/pages/login/index.wxss */

.login {
  min-height: 100vh;
  background: linear-gradient(180deg, #ff6b35 0%, #ff8c5a 40%, #f5f5f5 40%, #f5f5f5 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------- 品牌区 ---------- */
.hero {
  padding: 72rpx 48rpx 56rpx;
  color: #fff;
}

.hero__logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
}

.hero__title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero__slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
}

/* ---------- 卡片 ---------- */
.card {
  margin: 0 40rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 53, 0.14);
}

/* ---------- 切换 Tab ---------- */
.tabs {
  position: relative;
  display: flex;
  padding-bottom: 24rpx;
  margin-bottom: 12rpx;
}

.tabs__item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #999;
  padding: 12rpx 0;
  transition: color 0.2s;
}

.tabs__item--active {
  color: #ff6b35;
  font-size: 32rpx;
  font-weight: 600;
}

.tabs__line {
  position: absolute;
  bottom: 0;
  width: 40%;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #ff6b35, #ff8c5a);
  transition: left 0.24s ease;
}

/* ---------- 微信登录 ---------- */
.wx-btn {
  margin-top: 24rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.28);
}

.wx-btn::after {
  border: none;
}

.wx-btn[disabled] {
  background: #a7e3c3;
  color: #fff;
  box-shadow: none;
}

.wx-icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  flex: none;
}

.wx-icon__bubble {
  position: absolute;
  background: #fff;
  border-radius: 50%;
}

.wx-icon__bubble--big {
  width: 16rpx;
  height: 16rpx;
  left: 8rpx;
  top: 14rpx;
}

.wx-icon__bubble--small {
  width: 10rpx;
  height: 10rpx;
  right: 8rpx;
  top: 24rpx;
  opacity: 0.85;
}

.divider {
  position: relative;
  text-align: center;
  margin: 44rpx 0 28rpx;
}

.divider::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 1rpx;
  background: #f0f0f0;
}

.divider__text {
  position: relative;
  padding: 0 20rpx;
  background: #fff;
  font-size: 22rpx;
  color: #bbb;
}

.other {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 1rpx solid #ffe0d3;
  background: #fff8f4;
}

.other__text {
  font-size: 28rpx;
  color: #ff6b35;
}

.other__icon {
  width: 34rpx;
  height: 34rpx;
  position: relative;
}

/* ---------- 输入框 ---------- */
.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 16rpx;
  background: #fafafa;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
}

.field--focus {
  border-color: #ff6b35;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 53, 0.1);
}

.field--error {
  border-color: #f56c6c;
  background: #fff8f8;
}

.field__input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
  min-width: 0;
}

.field__placeholder {
  color: #b8bcc4;
  font-size: 26rpx;
}

.field__error {
  margin: 10rpx 0 0 12rpx;
  font-size: 22rpx;
  color: #f56c6c;
  line-height: 1.5;
}

.form-error {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fef0f0;
  color: #f56c6c;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 图标：用户 / 锁 / 眼睛（纯 CSS） */
.icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex: none;
}

.icon-user__head {
  width: 13rpx;
  height: 13rpx;
  border: 3rpx solid #b8bcc4;
  border-radius: 50%;
  margin: 0 auto;
}

.icon-user__body {
  width: 24rpx;
  height: 11rpx;
  border: 3rpx solid #b8bcc4;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  margin: 3rpx auto 0;
  box-sizing: border-box;
}

.icon-lock__shackle {
  width: 16rpx;
  height: 12rpx;
  border: 3rpx solid #b8bcc4;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
  margin: 0 auto;
  box-sizing: border-box;
}

.icon-lock__body {
  width: 26rpx;
  height: 17rpx;
  background: #b8bcc4;
  border-radius: 4rpx;
  margin: 0 auto;
}

.eye {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: none;
}

.eye__outer {
  position: absolute;
  left: 2rpx;
  top: 9rpx;
  width: 32rpx;
  height: 18rpx;
  border: 3rpx solid #b8bcc4;
  border-radius: 50%;
  box-sizing: border-box;
}

.eye__pupil {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b8bcc4;
}

.eye__slash {
  position: absolute;
  left: -1rpx;
  top: 17rpx;
  width: 40rpx;
  height: 3rpx;
  background: #b8bcc4;
  transform: rotate(-40deg);
  border-radius: 2rpx;
}

/* ---------- 主按钮 ---------- */
.btn-gradient {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(255, 107, 53, 0.3);
}

.btn-gradient::after {
  border: none;
}

.btn-gradient[disabled] {
  background: #ffb59b;
  color: #fff;
  box-shadow: none;
}

.trouble {
  margin-top: 22rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8abb2;
}

/* ---------- 底部 ---------- */
.links {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
}

.links__text {
  color: #909399;
}

.links__action {
  color: #ff6b35;
  font-weight: 600;
  margin-left: 6rpx;
}

.footer {
  margin-top: auto;
  padding: 48rpx 0 0;
  text-align: center;
}

.footer__link {
  font-size: 24rpx;
  color: #ff8c5a;
}

.footer__tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #b8bcc4;
}

.footer__brand {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: #c8ccd4;
}
