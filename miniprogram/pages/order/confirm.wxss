/* 文件路径: miniprogram/pages/order/confirm.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

/* 地址卡 */
.addr {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
}

.addr__body {
  flex: 1;
  min-width: 0;
}

.addr__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.addr__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.addr__phone {
  font-size: 26rpx;
  color: #666;
}

.addr__default {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #fff1eb;
  color: #ff6b35;
  font-size: 20rpx;
  line-height: 30rpx;
}

.addr__detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.addr__empty {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #999;
}

.addr__pin {
  font-size: 34rpx;
}

.addr__arrow {
  flex: none;
  font-size: 32rpx;
  color: #c8c9cc;
}

/* 商品卡 */
.goods {
  display: flex;
  gap: 20rpx;
}

.goods__img {
  width: 160rpx;
  height: 160rpx;
  flex: none;
  border-radius: 12rpx;
  background: #f4f4f5;
}

.goods__img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8c9cc;
  font-size: 24rpx;
}

.goods__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods__title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods__meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #999;
}

.goods__price {
  margin-top: auto;
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b35;
}

/* 提示 */
.tips__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.tips__item {
  font-size: 23rpx;
  color: #999;
  line-height: 1.8;
}

/* 结算栏 */
.bar__total {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.bar__price {
  margin-left: 6rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #ff6b35;
}

.bar__submit {
  width: 260rpx;
  min-width: 260rpx;
}

/* 地址弹层 */
.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.45);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 31;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.25s ease;
}

.sheet--open {
  transform: translateY(0);
}

.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.sheet__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.sheet__close {
  font-size: 30rpx;
  color: #999;
  padding: 0 8rpx;
}

.sheet__list {
  max-height: 52vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.sheet__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.sheet__item--active .sheet__name {
  color: #ff6b35;
}

.sheet__main {
  flex: 1;
  min-width: 0;
}

.sheet__row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sheet__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.sheet__phone {
  font-size: 24rpx;
  color: #666;
}

.sheet__tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #fff1eb;
  color: #ff6b35;
  font-size: 20rpx;
}

.sheet__detail {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.sheet__check {
  flex: none;
  width: 40rpx;
  text-align: center;
  color: #ff6b35;
  font-size: 30rpx;
}

.sheet__empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}

.sheet__footer {
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f2f2f2;
}

.empty__icon {
  font-size: 70rpx;
  margin-bottom: 16rpx;
}

.empty__btn {
  margin-top: 28rpx;
  width: 260rpx;
}
