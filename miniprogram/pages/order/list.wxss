/* 文件路径: miniprogram/pages/order/list.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 24rpx;
}

/* 角色切换 */
.role-switch {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 24rpx 0;
  padding: 6rpx;
  border-radius: 32rpx;
  background: #ececee;
}

.role-switch__item {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.role-switch__item--active {
  background: #fff;
  color: #ff6b35;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 状态标签 */
.tabs {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 16rpx 8rpx;
}

.tabs__item {
  display: inline-block;
  padding: 0 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0 6rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.tabs__item--active {
  background: #fff1eb;
  color: #ff6b35;
  font-weight: 600;
}

/* 订单卡片 */
.list {
  padding: 8rpx 24rpx 0;
}

.order {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order__no {
  font-size: 22rpx;
  color: #999;
  font-family: Consolas, Monaco, monospace;
}

.order__goods {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.order__img {
  width: 140rpx;
  height: 140rpx;
  flex: none;
  border-radius: 12rpx;
  background: #f4f4f5;
}

.order__img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #c8c9cc;
}

.order__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.order__title {
  font-size: 27rpx;
  color: #222;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order__time {
  margin-top: auto;
  font-size: 22rpx;
  color: #aaa;
}

.order__price {
  flex: none;
  text-align: right;
}

.order__amount {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ff6b35;
}

.order__count {
  font-size: 22rpx;
  color: #aaa;
}

.order__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.order__hint {
  flex: 1;
  font-size: 22rpx;
  color: #bbb;
}

.order__actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.order__btn {
  padding: 0 26rpx;
  height: 56rpx;
  line-height: 54rpx;
  border-radius: 28rpx;
  border: 1rpx solid #dcdfe6;
  font-size: 24rpx;
  color: #666;
  background: #fff;
}

.order__btn--primary {
  border: none;
  color: #fff;
  font-weight: 500;
  background: linear-gradient(90deg, #ff6b35, #ff8c5a);
}

.loading-more {
  padding: 20rpx 0 40rpx;
  text-align: center;
  font-size: 23rpx;
  color: #bbb;
}

/* 空态 */
.empty__icon {
  font-size: 74rpx;
  margin-bottom: 18rpx;
}

.empty__title {
  font-size: 28rpx;
  color: #666;
}

.empty__desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #aaa;
}

.empty__btn {
  margin: 36rpx auto 0;
  width: 260rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.modal {
  width: 620rpx;
  padding: 36rpx 32rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.modal__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  text-align: center;
}

.modal__textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
}

.modal__placeholder {
  color: #b8bcc4;
  font-size: 25rpx;
}

.modal__count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 21rpx;
  color: #bbb;
}

.modal__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.modal__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #f4f4f5;
  color: #666;
  font-size: 28rpx;
}

.modal__btn--primary {
  background: linear-gradient(90deg, #ff6b35, #ff8c5a);
  color: #fff;
  font-weight: 500;
}
