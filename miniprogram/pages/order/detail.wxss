/* 文件路径: miniprogram/pages/order/detail.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 状态横幅 */
.banner {
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff9a5a, #ff6b35);
}

.banner--0 {
  background: linear-gradient(135deg, #f7a94b, #e6a23c);
}

.banner--1 {
  background: linear-gradient(135deg, #5aa9ff, #409eff);
}

.banner--2 {
  background: linear-gradient(135deg, #9b7bff, #7c5cf5);
}

.banner--3 {
  background: linear-gradient(135deg, #7ed06b, #52b341);
}

.banner--4 {
  background: linear-gradient(135deg, #a8abb2, #86898f);
}

.banner--5 {
  background: linear-gradient(135deg, #ff8b8b, #f56c6c);
}

.banner--6 {
  background: linear-gradient(135deg, #b9bcc2, #9a9da3);
}

.banner__status {
  font-size: 42rpx;
  font-weight: 600;
}

.banner__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
  line-height: 1.6;
}

.banner__extra {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
}

/* 内容区上移，与横幅形成层次 */
.body {
  margin-top: -24rpx;
  padding: 0 24rpx;
}

/* 商品 */
.goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.goods__img {
  width: 150rpx;
  height: 150rpx;
  flex: none;
  border-radius: 12rpx;
  background: #f4f4f5;
}

.goods__img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8c9cc;
  font-size: 24rpx;
}

.goods__info {
  flex: 1;
  min-width: 0;
}

.goods__title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods__meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999;
}

.goods__bottom {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.goods__price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b35;
}

.goods__count {
  font-size: 24rpx;
  color: #999;
}

.goods__arrow {
  flex: none;
  color: #c8c9cc;
  font-size: 30rpx;
}

/* 地址 */
.addr {
  display: flex;
  gap: 14rpx;
}

.addr__pin {
  flex: none;
  font-size: 32rpx;
  line-height: 1.3;
}

.addr__body {
  flex: 1;
  min-width: 0;
}

.addr__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.addr__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.addr__phone {
  font-size: 25rpx;
  color: #666;
}

.addr__detail {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #666;
  line-height: 1.5;
}

/* 订单信息 */
.info__row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: 25rpx;
}

.info__label {
  flex: none;
  width: 150rpx;
  color: #999;
}

.info__value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.info__value--price {
  color: #ff6b35;
  font-weight: 600;
}

.info__copy {
  flex: none;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border: 1rpx solid #ffd0bd;
  border-radius: 20rpx;
  color: #ff6b35;
  font-size: 21rpx;
}

/* 原因块 */
.reason {
  border-left: 6rpx solid #dcdfe6;
}

.reason--cancel {
  border-left-color: #c0c4cc;
  background: #fafafa;
}

.reason--refund {
  border-left-color: #ff6b35;
  background: #fff8f5;
}

.reason--reject {
  border-left-color: #f56c6c;
  background: #fff6f6;
}

.reason__title {
  font-size: 25rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.reason__text {
  font-size: 25rpx;
  color: #555;
  line-height: 1.6;
}

.reason__tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #f56c6c;
}

/* 时间线 */
.timeline {
  padding-bottom: 8rpx;
}

.tl {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 32rpx;
}

.tl:last-child {
  padding-bottom: 0;
}

.tl__dot {
  position: absolute;
  left: 6rpx;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #dcdfe6;
  box-shadow: 0 0 0 6rpx rgba(220, 223, 230, 0.25);
}

.dot--pay {
  background: #e6a23c;
  box-shadow: 0 0 0 6rpx rgba(230, 162, 60, 0.18);
}

.dot--ship {
  background: #409eff;
  box-shadow: 0 0 0 6rpx rgba(64, 158, 255, 0.18);
}

.dot--receive {
  background: #8b5cf6;
  box-shadow: 0 0 0 6rpx rgba(139, 92, 246, 0.18);
}

.dot--done {
  background: #67c23a;
  box-shadow: 0 0 0 6rpx rgba(103, 194, 58, 0.18);
}

.dot--cancel {
  background: #b1b3b8;
  box-shadow: 0 0 0 6rpx rgba(177, 179, 184, 0.18);
}

.dot--refund {
  background: #f56c6c;
  box-shadow: 0 0 0 6rpx rgba(245, 108, 108, 0.18);
}

.dot--refunded {
  background: #c8c9cc;
  box-shadow: 0 0 0 6rpx rgba(200, 201, 204, 0.18);
}

/* 竖线：连到下一个节点 */
.tl__line {
  position: absolute;
  left: 14rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: #eef0f3;
}

.tl__head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tl__action {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.tl__role {
  font-size: 22rpx;
  color: #999;
}

.tl__remark {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #777;
  line-height: 1.6;
}

.tl__time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* 联系入口 */
.contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  color: #555;
}

.contact__arrow {
  color: #c8c9cc;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.modal {
  width: 620rpx;
  padding: 36rpx 32rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.modal__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  text-align: center;
}

.modal__textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
}

.modal__placeholder {
  color: #b8bcc4;
  font-size: 25rpx;
}

.modal__count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 21rpx;
  color: #bbb;
}

.modal__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.modal__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #f4f4f5;
  color: #666;
  font-size: 28rpx;
}

.modal__btn--primary {
  background: linear-gradient(90deg, #ff6b35, #ff8c5a);
  color: #fff;
  font-weight: 500;
}

.empty__icon {
  font-size: 70rpx;
  margin-bottom: 16rpx;
}

.empty__btn {
  margin-top: 28rpx;
  width: 260rpx;
}

/* ===== 评价区 ===== */
.review-section__action {
  float: right;
  font-size: 24rpx;
  font-weight: 400;
  color: #ff6b35;
}

.rv {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.rv:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rv__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rv__from {
  font-size: 24rpx;
  color: #ff6b35;
  background: #fff2ec;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.rv__stars {
  display: flex;
}

.rv__star {
  font-size: 26rpx;
  color: #e0e0e0;
  margin-left: 2rpx;
}

.rv__star--on {
  color: #ff6b35;
}

.rv__user {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
}

.rv__content {
  margin-top: 8rpx;
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
}

.rv__images {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.rv__img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.rv__follow {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.rv__follow-tag {
  font-size: 22rpx;
  color: #ff6b35;
  font-weight: 600;
}

.rv__follow-text {
  font-size: 25rpx;
  color: #555;
  line-height: 1.6;
}

.rv__reply {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: #eef5ff;
  border-radius: 12rpx;
}

.rv__reply-tag {
  font-size: 22rpx;
  color: #409eff;
  font-weight: 600;
}

.rv__reply-text {
  font-size: 25rpx;
  color: #4a5a6a;
  line-height: 1.6;
}

.rv-empty {
  padding: 30rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.rv-empty__text {
  font-size: 26rpx;
  color: #999;
}

.rv-empty__hint {
  font-size: 21rpx;
  color: #bbb;
}
