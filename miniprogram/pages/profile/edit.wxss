/* 文件路径: miniprogram/pages/profile/edit.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card__label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 头像选择 */
.avatar-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-picker {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.avatar-picker__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #eee;
}

.avatar-picker__img--text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6b35;
  font-size: 56rpx;
  font-weight: 600;
  background: #fff3ec;
}

.avatar-picker__edit {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  padding: 2rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
}

/* 字段 */
.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.field__body {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field__body--column {
  flex-direction: column;
  align-items: stretch;
}

.field__input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: #333;
}

.field__ph {
  color: #c0c4cc;
}

.field__textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.field__count {
  font-size: 22rpx;
  color: #c0c4cc;
  flex-shrink: 0;
}

.field__count--over {
  color: #ff3b30;
}

.field__error {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ff3b30;
}

/* 性别 */
.gender-group {
  display: flex;
  gap: 40rpx;
}

.gender {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.gender__text {
  font-size: 28rpx;
  color: #333;
}

.tips {
  padding: 0 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.save-btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: #ffb59b;
  color: #fff;
}
