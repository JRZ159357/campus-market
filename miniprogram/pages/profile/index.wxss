/* 文件路径: miniprogram/pages/profile/index.wxss */

.page {
  min-height: 100vh;
  padding: 0 24rpx 180rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

/* ---------------- 顶部用户信息卡：橙色渐变 ---------------- */
.hero {
  position: relative;
  margin: 0 -24rpx 24rpx;
  padding: 60rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-radius: 0 0 32rpx 32rpx;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.18);
}

.hero__top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero__avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.hero__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  background: #fff;
}

.hero__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6b35;
  font-size: 48rpx;
  font-weight: 600;
}

.hero__avatar-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  color: #ff6b35;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.hero__info {
  flex: 1;
  min-width: 0;
}

.hero__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero__name {
  font-size: 36rpx;
  font-weight: 600;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__role {
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.24);
  font-size: 20rpx;
  line-height: 30rpx;
}

.hero__intro {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__credit-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 12rpx;
}

.hero__credit-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  /* 等级色在深色渐变上偏暗，这里统一加一层白底保证可读性 */
  color: #fff !important;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.25);
}

.hero__credit-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero__level {
  margin-left: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #fff !important;
}

.hero__edit {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 26rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 统计行 */
.hero__stats {
  display: flex;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.hero__stat {
  flex: 1;
  text-align: center;
}

.hero__value {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero__label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* 未登录态 */
.hero--guest {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx 40rpx;
}

.hero__guest-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 56rpx;
  line-height: 108rpx;
  text-align: center;
}

.hero__guest-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.hero__guest-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero__guest-btn {
  margin-top: 26rpx;
  padding: 12rpx 52rpx;
  background: #fff;
  color: #ff6b35;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* ---------------- 卡片 ---------------- */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 20rpx;
}

/* ---------------- 我的订单 ---------------- */
.order-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-card__head .card__title {
  margin-bottom: 0;
}

.order-card__more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.order-card__arrow {
  margin-left: 4rpx;
  font-size: 30rpx;
  line-height: 1;
}

.order-card__grid {
  display: flex;
  flex-wrap: wrap;
}

.order-card__item {
  width: 20%;
  text-align: center;
}

.order-card__icon {
  position: relative;
  display: inline-block;
}

.order-card__emoji {
  font-size: 44rpx;
  line-height: 1.2;
}

.order-card__badge {
  position: absolute;
  top: -6rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.order-card__label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
}

/* ---------------- 功能宫格：3 列 ---------------- */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid__item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.grid__item:active {
  opacity: 0.7;
}

.grid__item--disabled {
  opacity: 0.45;
}

.grid__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  font-size: 40rpx;
  line-height: 84rpx;
  text-align: center;
}

.grid__label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #555;
}

/* ---------------- 底部 ---------------- */
.logout {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 44rpx;
  color: #ff3b30;
  font-size: 30rpx;
}

.note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
