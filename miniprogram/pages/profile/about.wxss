/* 文件路径: miniprogram/pages/profile/about.wxss */
.page {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

/* 顶部 Logo */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 0 50rpx;
}

.logo__icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a6b);
  box-shadow: 0 10rpx 26rpx rgba(255, 107, 53, 0.28);
}

.logo__name {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #222;
}

.logo__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.logo__version {
  margin-top: 16rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #bbb;
  font-size: 21rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 18rpx;
}

.intro {
  font-size: 25rpx;
  color: #666;
  line-height: 1.8;
}

/* 特色功能 */
.feature {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f6f6f7;
}

.feature:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.feature__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #fff3ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex: none;
}

.feature__body {
  flex: 1;
  min-width: 0;
}

.feature__title {
  font-size: 27rpx;
  color: #333;
  font-weight: 500;
}

.feature__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a8abb2;
  line-height: 1.6;
}

/* 条款 */
.terms__item {
  font-size: 24rpx;
  color: #777;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.contact {
  margin: 40rpx 0 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 44rpx;
  color: #ff6b35;
  font-size: 28rpx;
}

.copyright {
  margin-top: 26rpx;
  text-align: center;
  font-size: 21rpx;
  color: #ccc;
}
