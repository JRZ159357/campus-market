/* 文件路径: miniprogram/pages/product/my.wxss */
.my {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部状态标签 */
.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  display: flex;
  background: #fff;
  padding: 18rpx 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tab {
  flex: none;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  font-size: 27rpx;
  color: #666;
  border-radius: 32rpx;
}

.tab--active {
  background: #fff2ec;
  color: #ff6b35;
  font-weight: 600;
}

/* 列表 */
.list {
  padding: 20rpx 24rpx 40rpx;
}

.item {
  position: relative;
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.item__cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  background: #f0f0f0;
  flex: none;
}

.item__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  padding-right: 40rpx;
}

.item__title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 80rpx;
}

.item__row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.item__price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6b35;
}

.item__original {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #bbb;
  text-decoration: line-through;
}

.item__meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #aaa;
}

.item__views {
  margin-left: 12rpx;
}

.item__time {
  margin-left: auto;
}

.item__reason {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #f56c6c;
  background: #fef0f0;
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item__more {
  position: absolute;
  right: 16rpx;
  top: 12rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 48rpx;
  text-align: center;
  color: #999;
  font-size: 34rpx;
}

/* 状态标签补充色 */
.tag--off {
  background: #f4f4f5;
  color: #909399;
}

.tag--sold {
  background: #ecf5ff;
  color: #409eff;
}

.load-more {
  text-align: center;
  font-size: 23rpx;
  color: #bbb;
  padding: 20rpx 0 40rpx;
}

.empty__icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty__btn {
  width: 280rpx;
  margin: 32rpx auto 0;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff9a6b);
  color: #fff;
  font-size: 52rpx;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 53, 0.35);
}
