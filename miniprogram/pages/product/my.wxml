<!-- 文件路径: miniprogram/pages/product/my.wxml -->
<view class="my">
  <!-- 状态标签 -->
  <scroll-view scroll-x class="tabs" enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="label"
      class="tab {{activeIndex === index ? 'tab--active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="spinner"></view>
    <view>加载中…</view>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{error}}" class="empty">
    <view>加载失败，请检查网络</view>
    <button class="btn-ghost empty__btn" bindtap="retry">重新加载</button>
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty__icon">📦</view>
    <view>{{activeIndex === 0 ? '还没有发布商品' : '该状态下暂无商品'}}</view>
    <button wx:if="{{activeIndex === 0}}" class="btn-primary empty__btn" bindtap="goPublish">去发布</button>
  </view>

  <!-- 商品列表 -->
  <view wx:else class="list">
    <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <image class="item__cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="item__body">
        <view class="item__title">{{item.title}}</view>
        <view class="item__row">
          <text class="item__price">¥{{item.priceText}}</text>
          <text wx:if="{{item.originalPrice}}" class="item__original">¥{{item.originalPrice}}</text>
        </view>
        <view class="item__meta">
          <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
          <text class="item__views">{{item.viewCount || 0}} 浏览</text>
          <text class="item__views">{{item.favoriteCount || 0}} 收藏</text>
          <text class="item__time">{{item.timeText}}</text>
        </view>
        <view wx:if="{{item.auditReason}}" class="item__reason">原因：{{item.auditReason}}</view>
      </view>
      <view class="item__more" data-item="{{item}}" catchtap="showActions">⋯</view>
    </view>

    <view class="load-more">
      <block wx:if="{{loadingMore}}">加载中…</block>
      <block wx:elif="{{hasMore}}">上拉加载更多</block>
      <block wx:else>已经到底了，共 {{total}} 件</block>
    </view>
  </view>

  <!-- 悬浮发布按钮 -->
  <view wx:if="{{list.length}}" class="fab" bindtap="goPublish">＋</view>
</view>
