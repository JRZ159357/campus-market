<!-- 文件路径: miniprogram/pages/product/list.wxml -->
<view class="page">
  <!-- 筛选栏 -->
  <view class="filter">
    <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="filter__item">
        <text class="filter__text">{{categoryNames[categoryIndex]}}</text>
        <text class="filter__arrow">▾</text>
      </view>
    </picker>
    <view class="filter__item {{priceIndex > 0 ? 'filter__item--active' : ''}}" bindtap="togglePrice">
      <text class="filter__text">{{priceIndex > 0 ? priceRanges[priceIndex].label : '价格'}}</text>
      <text class="filter__arrow">{{showPrice ? '▴' : '▾'}}</text>
    </view>
    <view class="filter__item {{sortKey === 'default' ? 'filter__item--active' : ''}}" data-key="default" bindtap="onSortTap">综合</view>
    <view class="filter__item {{sortKey === 'new' ? 'filter__item--active' : ''}}" data-key="new" bindtap="onSortTap">最新</view>
    <view class="filter__item {{sortKey === 'price' ? 'filter__item--active' : ''}}" data-key="price" bindtap="onSortTap">
      价格<text class="filter__arrow">{{sortKey === 'price' && !priceAsc ? '↑' : '↓'}}</text>
    </view>
  </view>

  <!-- 价格区间面板 -->
  <view wx:if="{{showPrice}}" class="pricepanel">
    <view
      wx:for="{{priceRanges}}"
      wx:key="label"
      class="chip {{priceIndex === index ? 'chip--active' : ''}}"
      data-index="{{index}}"
      bindtap="onPriceChange"
    >{{item.label}}</view>
    <view class="pricepanel__reset" bindtap="resetFilter">重置</view>
  </view>

  <view class="summary">共 {{total}} 件商品</view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="spinner"></view>
    <view>加载中…</view>
  </view>

  <view wx:elif="{{!left.length && !right.length}}" class="empty">
    <view class="empty__icon">📦</view>
    <view>没有符合条件的商品</view>
    <view class="empty__btn" bindtap="resetFilter">重置筛选</view>
  </view>

  <view wx:else class="waterfall">
    <view class="waterfall__col">
      <product-card wx:for="{{left}}" wx:key="id" item="{{item}}" />
    </view>
    <view class="waterfall__col">
      <product-card wx:for="{{right}}" wx:key="id" item="{{item}}" />
    </view>
  </view>

  <view wx:if="{{left.length || right.length}}" class="loadmore">
    <text wx:if="{{loadingMore}}">加载中…</text>
    <text wx:elif="{{!hasMore}}">— 没有更多了 —</text>
    <text wx:else>上拉加载更多</text>
  </view>

  <view wx:if="{{showTop}}" class="totop" bindtap="backToTop">↑</view>
</view>
