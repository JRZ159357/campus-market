/* 文件路径: miniprogram/pages/index/index.wxss */

.home {
  padding: 20rpx 32rpx 180rpx;
  box-sizing: border-box;
}

/* ---------- 顶部搜索栏 ---------- */
.topbar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search__placeholder {
  font-size: 26rpx;
  color: #aaa;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.msg {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-left: 20rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.msg__icon {
  font-size: 32rpx;
}

.msg__dot {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff4d4f;
  border: 2rpx solid #fff;
}

/* ---------- 公告栏 ---------- */
.notice {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ff7a45, #ff6b35);
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 53, 0.25);
  overflow: hidden;
}

.notice__icon {
  flex: none;
  font-size: 26rpx;
  margin-right: 12rpx;
}

/* 轨道负责裁切，文字自己横向滚动：公告长度不可控，
   不滚动的话长文案会被截断成半句话 */
.notice__track {
  flex: 1;
  overflow: hidden;
  height: 36rpx;
}

.notice__text {
  display: inline-block;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #fff;
  animation: notice-scroll 12s linear infinite;
}

.notice__close {
  flex: none;
  width: 40rpx;
  text-align: right;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

@keyframes notice-scroll {
  0% {
    transform: translateX(100%);
  }
  100% {
    transform: translateX(-100%);
  }
}

/* ---------- 轮播图 ---------- */
.banner {
  height: 380rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.12);
}

.banner__img {
  width: 100%;
  height: 100%;
  display: block;
}

.banner__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.4));
}

.banner__title {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  right: 28rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.banner--empty {
  background: linear-gradient(135deg, #ff6b35, #ffa06b);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.banner__slogan {
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.banner__sub {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
}

/* ---------- 分类宫格 ---------- */
.cats {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 0 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.cats__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.cats__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #fff4ef;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cats__img {
  width: 56rpx;
  height: 56rpx;
}

.cats__emoji {
  font-size: 40rpx;
  line-height: 1;
}

.cats__label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  max-width: 140rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 区块标题 ---------- */
.section {
  margin-bottom: 12rpx;
}

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.section__sub {
  font-size: 22rpx;
  color: #b0b0b0;
}

/* ---------- 热门推荐 ---------- */
.hot {
  width: 100%;
  margin-bottom: 24rpx;
}

.hot__row {
  display: flex;
  padding-bottom: 8rpx;
}

.hot__item {
  width: 260rpx;
  flex: none;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}

.hot__cover {
  position: relative;
  width: 260rpx;
  height: 200rpx;
  background: #f7f7f7;
}

.hot__img {
  width: 100%;
  height: 100%;
  display: block;
}

.hot__badge {
  position: absolute;
  top: 0;
  left: 0;
  padding: 4rpx 12rpx;
  font-size: 19rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff9a6b);
  border-bottom-right-radius: 14rpx;
}

.hot__title {
  padding: 14rpx 16rpx 0;
  font-size: 25rpx;
  color: #333;
  line-height: 1.4;
  height: 70rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.hot__price {
  padding: 10rpx 16rpx 16rpx;
  color: #ff6b35;
  font-size: 32rpx;
  font-weight: 700;
}

.hot__yuan {
  font-size: 20rpx;
  font-weight: 600;
  margin-right: 2rpx;
}

/* ---------- 瀑布流 ---------- */
.waterfall {
  display: flex;
  justify-content: space-between;
}

.waterfall__col {
  width: calc(50% - 8rpx);
}

/* ---------- 加载 / 空态 ---------- */
.loadmore {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx 0 10rpx;
  font-size: 23rpx;
  color: #b0b0b0;
}

.loadmore__dot {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #ffd9cb;
  border-top-color: #ff6b35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.empty__icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty__tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

.error {
  padding: 140rpx 0;
  text-align: center;
}

.error__icon {
  font-size: 76rpx;
}

.error__text {
  margin: 18rpx 0 26rpx;
  color: #999;
  font-size: 26rpx;
}

.error__btn {
  display: inline-block;
  padding: 0 44rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  border: 1rpx solid #ff6b35;
  color: #ff6b35;
  font-size: 26rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
