/* 文件路径: miniprogram/pages/review/follow.wxss */
.follow-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 原评价块：浅灰底，和追评输入区形成层次 */
.origin {
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.origin__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.origin__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.origin__time {
  font-size: 22rpx;
  color: #aaa;
}

.origin__stars {
  display: flex;
  align-items: center;
  margin: 14rpx 0 8rpx;
}

.star {
  font-size: 32rpx;
  color: #e0e0e0;
  margin-right: 6rpx;
}

.star--on {
  color: #ff6b35;
}

.origin__stars-text {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #ff6b35;
}

.origin__content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

.origin__images {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.origin__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.origin__product {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #aaa;
}

.tip {
  margin: 20rpx 8rpx 0;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.editor {
  width: 100%;
  min-height: 180rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
}

.editor__count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.images__item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.images__img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f2f2f2;
}

.images__del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.images__add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #bbb;
}

.images__plus {
  font-size: 48rpx;
  line-height: 1;
}

.images__hint {
  font-size: 22rpx;
  margin-top: 8rpx;
}
