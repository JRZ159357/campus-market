/* 文件路径: miniprogram/pages/review/list.wxss */
.list-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 24rpx;
}

/* 概览 */
.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  background: #fff;
}

.summary__left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.summary__score {
  font-size: 60rpx;
  font-weight: 700;
  color: #ff6b35;
  line-height: 1;
}

.summary__stars {
  display: flex;
}

.star {
  font-size: 28rpx;
  color: #e0e0e0;
}

.star--on {
  color: #ff6b35;
}

.star--sm {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.summary__count {
  font-size: 22rpx;
  color: #999;
}

.summary__right {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: 32rpx;
  border-left: 1rpx solid #f0f0f0;
}

.summary__rate {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.summary__rate-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 筛选条 */
.filters {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
}

.filters__item {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
  transition: all 0.15s ease;
}

.filters__item--on {
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
}

/* 评价卡片 */
.reviews {
  padding: 24rpx;
}

.review {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.review__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.review__avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f2f2;
}

/* 匿名用户没有头像：用灰底首字占位，视觉上仍是一个"人" */
.review__avatar--anon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ececec;
  color: #9a9a9a;
  font-size: 28rpx;
}

.review__user {
  flex: 1;
  min-width: 0;
}

.review__name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.review__name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.review__anon {
  font-size: 20rpx;
  color: #999;
  background: #f2f2f2;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.review__stars {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.review__time {
  margin-left: 12rpx;
  font-size: 21rpx;
  color: #bbb;
}

.review__level {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fafafa;
}

.review__content {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
  word-break: break-word;
}

/* 图片：3 列网格 */
.review__images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}

.review__img {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

/* 追评块 */
.review__follow {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
}

.review__follow-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review__follow-tag {
  font-size: 23rpx;
  color: #ff6b35;
  font-weight: 600;
}

.review__follow-time {
  font-size: 20rpx;
  color: #bbb;
}

.review__follow-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* 卖家回复块 */
.review__reply {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  background: #eef5ff;
  border-radius: 16rpx;
}

.review__reply-tag {
  font-size: 23rpx;
  color: #409eff;
  font-weight: 600;
}

.review__reply-text {
  font-size: 26rpx;
  color: #4a5a6a;
  line-height: 1.6;
}

.list-foot {
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
