/* 文件路径: miniprogram/pages/review/edit.wxss */
.review-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 商品信息条 */
.goods {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.goods__cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f2f2f2;
}

.goods__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c0c0c0;
  font-size: 22rpx;
}

.goods__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.goods__title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods__price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff6b35;
}

.goods__type {
  font-size: 22rpx;
  color: #ff6b35;
  background: #fff2ec;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.tip {
  margin: 20rpx 8rpx 0;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

/* 卡片 */
.card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.card__optional {
  font-size: 22rpx;
  font-weight: 400;
  color: #aaa;
}

/* 维度打星 */
.dim {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dim:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dim__head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.dim__label {
  font-size: 27rpx;
  color: #333;
}

.dim__tip {
  font-size: 21rpx;
  color: #bbb;
}

.dim__stars {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

/* 星星：实心橙 #FF6B35，空心灰；点击有缩放动画 */
.star {
  font-size: 52rpx;
  line-height: 1;
  color: #e0e0e0;
  margin-right: 14rpx;
  transition: transform 0.15s ease, color 0.15s ease;
}

.star--on {
  color: #ff6b35;
}

.star--hover {
  transform: scale(1.25);
}

.dim__text {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #ff6b35;
}

/* 文字输入 */
.editor {
  width: 100%;
  min-height: 160rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
}

.editor__count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
}

/* 图片 */
.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.images__item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.images__img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f2f2f2;
}

.images__del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.images__add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #bbb;
}

.images__plus {
  font-size: 48rpx;
  line-height: 1;
}

.images__hint {
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 匿名开关 */
.anon {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anon__text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 20rpx;
}

.anon__title {
  font-size: 28rpx;
  color: #333;
}

.anon__desc {
  font-size: 21rpx;
  color: #aaa;
  line-height: 1.4;
}
