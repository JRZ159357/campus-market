/* 文件路径: miniprogram/pages/review/pending.wxss */
.pending-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.pending-tip {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  background: #fff7f0;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #c96a2e;
  line-height: 1.6;
}

.item {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.item__no {
  font-size: 22rpx;
  color: #999;
}

.item__time {
  font-size: 21rpx;
  color: #bbb;
}

.item__body {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.item__cover {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f2f2f2;
}

.item__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #c0c0c0;
}

.item__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item__title {
  font-size: 27rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item__price {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b35;
}

.item__peer {
  font-size: 22rpx;
  color: #999;
}

.item__foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.item__btn {
  padding: 12rpx 32rpx;
  font-size: 25rpx;
  border-radius: 30rpx;
}

.item__btn--primary {
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
}

.list-foot {
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
