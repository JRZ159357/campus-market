/* 文件路径: miniprogram/pages/address/list.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.addr {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.addr__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.addr__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.addr__phone {
  font-size: 26rpx;
  color: #666;
}

.addr__default {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #fff1eb;
  color: #ff6b35;
  font-size: 20rpx;
  line-height: 30rpx;
}

.addr__detail {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.addr__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f5f5f5;
}

.addr__action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.addr__action--on {
  color: #ff6b35;
}

.addr__radio {
  font-size: 26rpx;
}

.addr__ops {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.addr__op {
  font-size: 24rpx;
  color: #666;
}

.addr__op--danger {
  color: #f56c6c;
}

.addr__add {
  flex: 1;
}

.empty__icon {
  font-size: 74rpx;
  margin-bottom: 18rpx;
}

.empty__title {
  font-size: 28rpx;
  color: #666;
}

.empty__desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #aaa;
  line-height: 1.6;
  padding: 0 40rpx;
}

.empty__btn {
  margin: 36rpx auto 0;
  width: 280rpx;
}
