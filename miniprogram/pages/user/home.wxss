/* 文件路径: miniprogram/pages/user/home.wxss */
.home {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

/* ---------------- 顶部用户信息卡 ---------------- */
.info {
  padding: 28rpx 32rpx 32rpx;
  background: #fff;
}

.info__top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.info__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex: none;
}

.info__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffd0bf, #ffb59b);
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
}

.info__main {
  flex: 1;
  min-width: 0;
}

.info__name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.info__name {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info__verified {
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #ff6b35, #ff9a6b);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
}

.info__role {
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  background: #f4f4f5;
  color: #909399;
  font-size: 20rpx;
  line-height: 30rpx;
}

.info__intro {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.info__gender {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #bbb;
}

.info__credit {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.info__credit-num {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.info__credit-label {
  font-size: 22rpx;
  color: #999;
}

.info__level {
  margin-left: 6rpx;
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
}

.info__follow {
  flex: none;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a6b);
  color: #fff;
  font-size: 25rpx;
  font-weight: 500;
}

.info__follow--on {
  background: #f4f4f5;
  color: #909399;
}

/* ---------------- 数据统计 ---------------- */
.stats {
  display: flex;
  padding: 24rpx 0 28rpx;
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 24rpx;
}

.stats__item {
  flex: 1;
  text-align: center;
}

.stats__value {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.2;
}

.stats__unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 2rpx;
}

.stats__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

/* ---------------- Tab 切换 ---------------- */
.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tabs__item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 24rpx 0 20rpx;
  font-size: 28rpx;
  color: #666;
}

.tabs__item--active {
  color: #ff6b35;
  font-weight: 600;
}

.tabs__underline {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #ff6b35, #ff9a6b);
  animation: tabIn 0.22s ease;
}

@keyframes tabIn {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 48rpx;
    opacity: 1;
  }
}

/* ---------------- 瀑布流 ---------------- */
.waterfall {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 24rpx 0;
}

.waterfall__col {
  width: calc(50% - 8rpx);
}

.loadmore {
  padding: 28rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: #b0b0b0;
}

/* ---------------- 评价列表 ---------------- */
.reviews {
  padding: 20rpx 24rpx 0;
}

.review {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.review__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.review__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex: none;
}

.review__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffd0bf, #ffb59b);
  color: #fff;
  font-size: 26rpx;
}

.review__user {
  flex: 1;
  min-width: 0;
}

.review__name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.review__name {
  font-size: 27rpx;
  color: #333;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review__anon {
  padding: 1rpx 10rpx;
  border-radius: 14rpx;
  background: #f4f4f5;
  color: #909399;
  font-size: 18rpx;
  line-height: 26rpx;
}

.review__stars {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.star {
  font-size: 22rpx;
  color: #ddd;
  margin-right: 2rpx;
}

.star--on {
  color: #ffb400;
}

.review__time {
  margin-left: 12rpx;
  font-size: 21rpx;
  color: #bbb;
}

.review__content {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #444;
  line-height: 1.55;
}

.review__images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.review__img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  background: #f5f5f5;
}

.review__reply {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f4f8ff;
  font-size: 24rpx;
  color: #5a6b8c;
  line-height: 1.5;
}

.review__reply-tag {
  color: #409eff;
  margin-right: 6rpx;
}

.review__reply-text {
  color: #5a6b8c;
}

/* ---------------- 空态 ---------------- */
.empty {
  padding: 140rpx 0;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}

.empty__icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}
