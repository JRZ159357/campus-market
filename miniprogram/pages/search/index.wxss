/* 文件路径: miniprogram/pages/search/index.wxss */

.page {
  min-height: 100vh;
  padding: 20rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

/* 搜索栏 */
.searchbar {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.searchbar__box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 22rpx;
  background: #fff;
  border-radius: 36rpx;
}

.searchbar__icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.searchbar__input {
  flex: 1;
  font-size: 27rpx;
  color: #333;
}

.searchbar__ph {
  color: #bbb;
  font-size: 26rpx;
}

.searchbar__clear {
  width: 40rpx;
  text-align: center;
  color: #c0c0c0;
  font-size: 24rpx;
}

.searchbar__cancel {
  margin-left: 20rpx;
  font-size: 27rpx;
  color: #666;
}

/* 历史/热门 */
.block {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 24rpx;
}

.block__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.block__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.block__action {
  font-size: 23rpx;
  color: #999;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 10rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #555;
}

.tag--hot {
  background: #fff3ee;
  color: #ff6b35;
}

/* 筛选栏 */
.filterbar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  margin-bottom: 16rpx;
}

.filterbar__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.filterbar__item--active {
  color: #ff6b35;
  font-weight: 600;
}

.filterbar__item--filter {
  border-left: 1rpx solid #f0f0f0;
}

.filterbar__arrow {
  font-size: 18rpx;
  margin-left: 4rpx;
}

/* 筛选面板 */
.panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.panel__group {
  margin-bottom: 20rpx;
}

.panel__label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 14rpx;
}

.panel__options {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 10rpx 26rpx;
  margin: 0 16rpx 14rpx 0;
  border-radius: 30rpx;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #555;
}

.chip--active {
  background: #fff3ee;
  color: #ff6b35;
  font-weight: 600;
}

.panel__foot {
  display: flex;
  justify-content: space-between;
  padding-top: 10rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}

.panel__reset {
  color: #999;
  padding: 8rpx 0;
}

.panel__done {
  color: #ff6b35;
  font-weight: 600;
  padding: 8rpx 0;
}

.summary {
  padding: 6rpx 4rpx 18rpx;
  font-size: 23rpx;
  color: #999;
}

/* 瀑布流 */
.waterfall {
  display: flex;
  justify-content: space-between;
}

.waterfall__col {
  width: calc(50% - 8rpx);
}

.loadmore {
  padding: 28rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: #b0b0b0;
}

/* 空态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.empty__icon {
  font-size: 84rpx;
  margin-bottom: 20rpx;
}

.empty__tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

.empty__btn {
  display: inline-block;
  margin-top: 30rpx;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  border: 1rpx solid #ff6b35;
  color: #ff6b35;
  font-size: 25rpx;
}
