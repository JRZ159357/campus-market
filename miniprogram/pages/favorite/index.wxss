/* 文件路径: miniprogram/pages/favorite/index.wxss */
.page {
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.head {
  padding: 32rpx 4rpx 24rpx;
}

.head__main {
  display: flex;
  align-items: baseline;
}

.head__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}

.head__count {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #ff6b35;
  background: #fff3ee;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.head__tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #aaa;
}

.waterfall {
  display: flex;
  justify-content: space-between;
}

.waterfall__col {
  width: calc(50% - 8rpx);
}

.cell {
  position: relative;
}

.cell__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.42);
}

.cell__mask-text {
  padding: 8rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 30rpx;
  color: #fff;
  font-size: 24rpx;
}

.loadmore {
  padding: 28rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: #b0b0b0;
}

/* 空状态：用纯样式画一个"空收藏盒"，不依赖图片资源 */
.empty {
  padding: 120rpx 0 60rpx;
  text-align: center;
}

.empty__art {
  position: relative;
  width: 200rpx;
  height: 170rpx;
  margin: 0 auto 26rpx;
}

.empty__star {
  position: absolute;
  left: 50%;
  top: 10rpx;
  transform: translateX(-50%);
  width: 130rpx;
  height: 130rpx;
  line-height: 130rpx;
  text-align: center;
  font-size: 68rpx;
  color: #ffd8c7;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 10rpx 26rpx rgba(255, 107, 53, 0.12);
}

.empty__shadow {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 150rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
}

.empty__title {
  font-size: 31rpx;
  color: #333;
  font-weight: 600;
}

.empty__desc {
  margin-top: 12rpx;
  padding: 0 60rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

.empty__btn {
  display: inline-block;
  margin-top: 36rpx;
  padding: 0 56rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 53, 0.28);
}
