<!-- 文件路径: miniprogram/pages/favorite/index.wxml -->
<view class="page">
  <view class="head">
    <view class="head__main">
      <text class="head__title">我的收藏</text>
      <text class="head__count">{{count}} 件</text>
    </view>
    <view class="head__tip">长按卡片可取消收藏</view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="spinner"></view>
    <view>加载中…</view>
  </view>

  <view wx:elif="{{!left.length && !right.length}}" class="empty">
    <view class="empty__art">
      <view class="empty__star">★</view>
      <view class="empty__shadow"></view>
    </view>
    <view class="empty__title">还没有收藏商品</view>
    <view class="empty__desc">看到心仪的闲置，点一下收藏就能在这里找到它</view>
    <view class="empty__btn" bindtap="goHome">去逛逛</view>
  </view>

  <view wx:else class="waterfall">
    <view class="waterfall__col">
      <view
        wx:for="{{left}}"
        wx:key="id"
        class="cell"
        data-id="{{item.id}}"
        bindlongpress="onLongPress"
      >
        <product-card item="{{item}}" />
        <view
          wx:if="{{item.status !== 1}}"
          class="cell__mask"
          data-status="{{item.status}}"
          bindlongpress="onLongPress"
          catchtap="onMaskTap"
        >
          <text class="cell__mask-text">{{item.statusLabel}}</text>
        </view>
      </view>
    </view>
    <view class="waterfall__col">
      <view
        wx:for="{{right}}"
        wx:key="id"
        class="cell"
        data-id="{{item.id}}"
        bindlongpress="onLongPress"
      >
        <product-card item="{{item}}" />
        <view
          wx:if="{{item.status !== 1}}"
          class="cell__mask"
          data-status="{{item.status}}"
          bindlongpress="onLongPress"
          catchtap="onMaskTap"
        >
          <text class="cell__mask-text">{{item.statusLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{left.length || right.length}}" class="loadmore">
    <text wx:if="{{loadingMore}}">加载中…</text>
    <text wx:elif="{{!hasMore}}">— 没有更多了 —</text>
    <text wx:else>上拉加载更多</text>
  </view>
</view>
