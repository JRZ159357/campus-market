/* 文件路径: miniprogram/pages/publish/index.wxss */
.publish {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 未认证引导 */
.guard {
  margin: 120rpx 40rpx;
  padding: 64rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

.guard__icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.guard__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.guard__desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #999;
}

.guard__btn {
  margin-top: 44rpx;
}

/* 表单 */
.form {
  height: calc(100vh - 140rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.required {
  color: #ff6b35;
  margin-left: 6rpx;
}

.section__tip {
  font-size: 22rpx;
  color: #bbb;
}

.section__hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* 图片区 */
.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.image-item__img {
  width: 100%;
  height: 100%;
}

.image-item__badge {
  position: absolute;
  left: 0;
  top: 0;
  padding: 4rpx 14rpx;
  background: rgba(255, 107, 53, 0.92);
  color: #fff;
  font-size: 20rpx;
  border-bottom-right-radius: 12rpx;
}

.image-item__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  border-bottom-left-radius: 12rpx;
}

.image-item__move {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.35);
}

.image-item__arrow {
  width: 50%;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  line-height: 40rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ffcdb8;
  border-radius: 16rpx;
  background: #fffaf7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ff8a5c;
}

.image-add__plus {
  font-size: 52rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.image-add__text {
  font-size: 22rpx;
}

/* 输入 */
.input {
  height: 88rpx;
  background: #f7f7f7;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #222;
}

.cats {
  white-space: nowrap;
  display: flex;
}

.cat {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  background: #f5f5f5;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: #666;
}

.cat--active {
  background: #fff2ec;
  border-color: #ff6b35;
  color: #ff6b35;
  font-weight: 500;
}

.cat__icon {
  width: 32rpx;
  height: 32rpx;
}

.cat__icon-text {
  font-size: 28rpx;
}

/* 价格 */
.price-field {
  display: flex;
  align-items: baseline;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.price-field__symbol {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: 600;
  margin-right: 12rpx;
}

.price-field__input {
  flex: 1;
  font-size: 64rpx;
  font-weight: 700;
  color: #ff6b35;
  height: 90rpx;
  line-height: 90rpx;
}

.price-original {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.price-original__label {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.price-original__symbol {
  color: #999;
  font-size: 26rpx;
  margin-right: 6rpx;
}

.price-original__input {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

/* 描述 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f7f7f7;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.quota-tip {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  padding: 10rpx 0 20rpx;
}

.bottom-space {
  height: 40rpx;
}

/* 底部固定栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bottom-bar__info {
  display: flex;
  flex-direction: column;
}

.bottom-bar__label {
  font-size: 24rpx;
  color: #666;
}

.bottom-bar__sub {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.bottom-bar__btn {
  width: 300rpx;
  margin: 0;
}
