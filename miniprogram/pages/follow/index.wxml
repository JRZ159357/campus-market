<!-- 文件路径: miniprogram/pages/follow/index.wxml -->
<view class="page">
  <!-- 顶部 Tab -->
  <view class="tabs">
    <view class="tabs__item {{tab === 0 ? 'tabs__item--active' : ''}}" data-tab="0" bindtap="switchTab">
      <text>关注</text>
      <text class="tabs__num">{{followingTotal}}</text>
    </view>
    <view class="tabs__item {{tab === 1 ? 'tabs__item--active' : ''}}" data-tab="1" bindtap="switchTab">
      <text>粉丝</text>
      <text class="tabs__num">{{followersTotal}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="spinner"></view>
    <view>加载中…</view>
  </view>

  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty__icon">{{tab === 0 ? '👀' : '🌱'}}</view>
    <view class="empty__title">{{tab === 0 ? '还没有关注任何人' : '还没有粉丝'}}</view>
    <view class="empty__desc">
      {{tab === 0 ? '关注卖家，TA 上新时更容易找到' : '发布优质闲置并完成认证，更容易被关注'}}
    </view>
    <view class="empty__btn" bindtap="goHome">去逛逛</view>
  </view>

  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="userId" class="user">
      <view class="user__main" data-name="{{item.nickname}}" data-id="{{item.userId}}" bindtap="goSeller">
        <image wx:if="{{item.avatarUrl}}" class="user__avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="user__avatar user__avatar--text">{{item.initial}}</view>
        <view class="user__info">
          <view class="user__name">
            <text class="user__nick">{{item.nickname || '校园用户'}}</text>
            <text wx:if="{{item.studentVerified}}" class="badge-student">学生认证</text>
          </view>
          <view class="user__meta">在售 {{item.onSaleText}} 件 · 粉丝 {{item.fansText}}</view>
        </view>
      </view>
      <view
        class="user__btn {{item.followed ? 'user__btn--on' : ''}}"
        data-id="{{item.userId}}"
        catchtap="onToggle"
      >
        {{item.followed ? '已关注' : (tab === 0 ? '关注' : '回关')}}
      </view>
    </view>
  </view>

  <view wx:if="{{list.length}}" class="loadmore">
    <text wx:if="{{loadingMore}}">加载中…</text>
    <text wx:elif="{{!hasMore}}">— 没有更多了 —</text>
    <text wx:else>上拉加载更多</text>
  </view>
</view>
