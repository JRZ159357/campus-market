/* 文件路径: miniprogram/pages/follow/index.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #f5f5f5;
}

/* Tab */
.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tabs__item {
  position: relative;
  flex: 1;
  padding: 26rpx 0 22rpx;
  text-align: center;
  font-size: 29rpx;
  color: #666;
}

.tabs__item--active {
  color: #ff6b35;
  font-weight: 600;
}

.tabs__item--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #ff6b35, #ff8c5a);
}

.tabs__num {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.tabs__item--active .tabs__num {
  color: #ff8c5a;
}

/* 用户卡片 */
.list {
  padding: 20rpx 24rpx 0;
}

.user {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.user__main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.user__avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex: none;
}

.user__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffd0bf, #ffb59b);
  color: #fff;
  font-size: 36rpx;
}

.user__info {
  margin-left: 20rpx;
  min-width: 0;
}

.user__name {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.user__nick {
  max-width: 260rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 29rpx;
  font-weight: 500;
  color: #222;
}

.user__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

/* 关注按钮：未关注橙色描边，已关注灰色填充，切换有过渡动画 */
.user__btn {
  flex: none;
  min-width: 132rpx;
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 24rpx;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
  border-radius: 30rpx;
  background: #fff;
  transition: all 0.22s ease;
}

.user__btn--on {
  color: #999;
  border-color: #e2e2e2;
  background: #f4f4f4;
}

.user__btn:active {
  transform: scale(0.94);
}

.loadmore {
  padding: 24rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: #b0b0b0;
}

/* 空状态 */
.empty {
  padding: 150rpx 60rpx 0;
  text-align: center;
}

.empty__icon {
  font-size: 80rpx;
  margin-bottom: 22rpx;
}

.empty__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.empty__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

.empty__btn {
  display: inline-block;
  margin-top: 36rpx;
  padding: 0 56rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 53, 0.28);
}
