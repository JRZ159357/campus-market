/* 文件路径: miniprogram/pages/notice/detail.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card__head {
  display: flex;
  align-items: flex-start;
}

.card__icon {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 22rpx;
  background: #fff4ee;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__head-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.card__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
}

.card__meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.card__type {
  font-size: 21rpx;
  color: #ff6b35;
  background: #fff4ee;
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
}

.card__time {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #bbb;
}

.card__divider {
  height: 1rpx;
  background: #f2f2f2;
  margin: 28rpx 0;
}

.card__content {
  display: block;
  font-size: 29rpx;
  color: #444;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-all;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.actions__btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  color: #fff;
  font-size: 30rpx;
  border: none;
}

.actions__btn--ghost {
  background: #fff;
  color: #666;
  border: 1rpx solid #e5e5e5;
}

.actions__btn::after {
  border: none;
}

.empty {
  padding: 180rpx 60rpx;
  text-align: center;
}

.empty__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty__title {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty__tip {
  font-size: 25rpx;
  color: #bbb;
}
