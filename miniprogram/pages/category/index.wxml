<!-- 文件路径: miniprogram/pages/category/index.wxml -->
<view class="page">
  <!-- 顶部搜索 -->
  <view class="topbar">
    <view class="search" bindtap="goSearch">
      <text class="search__icon">🔍</text>
      <text class="search__placeholder">搜索 {{activeName === '全部' ? '全部分类' : activeName}} 的商品</text>
    </view>
    <view class="filter" bindtap="goList">筛选</view>
  </view>

  <view class="body">
    <!-- 左侧分类 -->
    <scroll-view class="side" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="side__item {{activeId === null ? 'side__item--active' : ''}}" data-id="{{null}}" bindtap="onCategoryTap">
        全部
      </view>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="side__item {{activeId === item.id ? 'side__item--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        {{item.name}}
      </view>
      <view class="side__placeholder"></view>
    </scroll-view>

    <!-- 右侧商品 -->
    <scroll-view
      class="main"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-top="{{scrollTop}}"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onScrollToLower"
    >
      <view class="sortbar">
        <view
          wx:for="{{sorts}}"
          wx:key="key"
          class="sortbar__item {{sortKey === item.key ? 'sortbar__item--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSortTap"
        >
          {{item.label}}
          <text wx:if="{{item.key === 'price'}}" class="sortbar__arrow">
            {{sortKey === 'price' && !priceAsc ? '↑' : '↓'}}
          </text>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading-wrap">
        <view class="spinner"></view>
        <view>加载中…</view>
      </view>

      <view wx:elif="{{!left.length && !right.length}}" class="empty">
        <view class="empty__icon">📦</view>
        <view>该分类下暂无商品</view>
        <view class="empty__tip">换个分类看看吧</view>
      </view>

      <view wx:else class="waterfall">
        <view class="waterfall__col">
          <product-card wx:for="{{left}}" wx:key="id" item="{{item}}" />
        </view>
        <view class="waterfall__col">
          <product-card wx:for="{{right}}" wx:key="id" item="{{item}}" />
        </view>
      </view>

      <view wx:if="{{left.length || right.length}}" class="loadmore">
        <text wx:if="{{loadingMore}}">加载中…</text>
        <text wx:elif="{{!hasMore}}">— 没有更多了 —</text>
        <text wx:else>上拉加载更多</text>
      </view>
    </scroll-view>
  </view>
</view>
